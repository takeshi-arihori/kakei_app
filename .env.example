# Repository rootのDB・Docker用ローカル設定です。
# Googleログインの準備用設定例はapps/web/.env.exampleとapps/api/.env.exampleを参照します。
POSTGRES_DB=kakei
POSTGRES_TEST_DB=kakei_test
POSTGRES_USER=kakei
POSTGRES_PASSWORD=kakei_local_password
POSTGRES_PORT=5432
SWAGGER_UI_PORT=8081

DATABASE_URL=postgresql://kakei:kakei_local_password@localhost:5432/kakei
TEST_DATABASE_URL=postgresql://kakei:kakei_local_password@localhost:5432/kakei_test

# localhost使い捨て認証（通常APIは有効化しない）。専用DBを明示準備して設定する。
# AUTH_DEV_DATABASE_URL=postgresql://local-user:local-password@127.0.0.1:5432/kakei_auth_dev
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# AUTH_DEV_ORIGIN=http://localhost:3000
# AUTH_DEV_HOST=127.0.0.1
# AUTH_DEV_PORT=3001
