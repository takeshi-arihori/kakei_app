        <mxCell id="edge-balance-case" value="方向・金額" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;strokeColor=#2563EB;fontSize=10;" edge="1" parent="1" source="concept-balance" target="concept-case"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-case-snapshot" value="1 : 1..*" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#16A34A;fontSize=10;" edge="1" parent="1" source="concept-case" target="concept-snapshot"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-snapshot-decision" value="確認・却下" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#F59E0B;fontSize=10;" edge="1" parent="1" source="concept-snapshot" target="concept-decision"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1430" y="1270"/><mxPoint x="605" y="1270"/></Array></mxGeometry></mxCell>
        <mxCell id="edge-snapshot-request" value="Payee開始" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#16A34A;fontSize=10;" edge="1" parent="1" source="concept-snapshot" target="concept-payment-request"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-request-report" value="Payerが支払う" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#DC2626;fontSize=10;" edge="1" parent="1" source="concept-payment-request" target="concept-payment-report"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-report-receipt" value="支払完了後" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;strokeColor=#7C3AED;fontSize=10;" edge="1" parent="1" source="concept-payment-report" target="concept-receipt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-receipt-archive" value="受取確認で成立" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeWidth=2;strokeColor=#7C3AED;fontSize=10;" edge="1" parent="1" source="concept-receipt" target="concept-archive"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-case-group-b" value="Case作成後" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=classic;strokeColor=#F59E0B;dashed=1;fontSize=10;" edge="1" parent="1" source="concept-case" target="concept-group-b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="1480"/><mxPoint x="370" y="1480"/></Array></mxGeometry></mxCell>

        <mxCell id="section-object" value="4. Object Examples" style="swimlane;html=1;startSize=42;rounded=1;strokeWidth=2;strokeColor=#7C3AED;fillColor=#EDE9FE;fontSize=19;fontStyle=1;connectable=0;" vertex="1" parent="1"><mxGeometry x="30" y="1700" width="1740" height="450" as="geometry"/></mxCell>
        <mxCell id="obj1" value="&lt;b&gt;Case 1 — Tが支払側から開始&lt;/b&gt;&lt;hr&gt;T: 実支払60,000／本来負担70,000&lt;br&gt;T Balance −10,000（Requester / Payer）&lt;br&gt;Y Balance ＋10,000（Payee）&lt;br&gt;SC-TY-001 v1: T → Y 10,000円&lt;br&gt;&lt;br&gt;&lt;b&gt;Tが外部支払い・完了申告 → Yが受取確認 → Archive&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#DC2626;fillColor=#FEF2F2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="1770" width="510" height="260" as="geometry"/></mxCell>
        <mxCell id="obj2" value="&lt;b&gt;Case 2 — Tが受取側から開始&lt;/b&gt;&lt;hr&gt;T: 実支払70,000／本来負担60,000&lt;br&gt;T Balance ＋10,000（Requester / Payee）&lt;br&gt;Y Balance −10,000（Payer）&lt;br&gt;SC-TY-002 v1: Y → T 10,000円&lt;br&gt;&lt;br&gt;&lt;b&gt;Tが支払いを請求 → Yが外部支払い・完了申告 → Tが受取確認 → Archive&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#16A34A;fillColor=#F0FDF4;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="1770" width="530" height="260" as="geometry"/></mxCell>
        <mxCell id="obj-retry" value="&lt;b&gt;却下・再申請 — Case IDを維持&lt;/b&gt;&lt;hr&gt;SC-TY-002 / v1: Tが請求&lt;br&gt;Rejected: 理由「支払いを確認できない」&lt;br&gt;SC-TY-002 / v2: 同じCaseへ新版を再申請&lt;br&gt;&lt;br&gt;v1は変更・削除しない&lt;br&gt;Yが支払完了を申告 → Tが受取確認 → v2をArchive&lt;br&gt;Case作成後の取引はGroup Bへ並行追加" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;strokeColor=#F59E0B;fillColor=#FFFBEB;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1240" y="1770" width="500" height="260" as="geometry"/></mxCell>
        <mxCell id="object-common" value="共通: 申請者はCaseを開始するRole。Payer / Payeeは精算残高から決まり、Payerの支払完了申告とPayeeの受取確認が揃ったSnapshot版だけをArchiveする。" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#2563EB;fillColor=#EFF6FF;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="2065" width="1420" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
