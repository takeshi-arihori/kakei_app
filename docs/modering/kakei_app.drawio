        <mxCell id="concept-snapshot" value="&lt;b&gt;Request Snapshot&lt;/b&gt;&lt;hr&gt;version: 1..*&lt;br&gt;requestedBy・requestedAt&lt;br&gt;取引集合・精算額&lt;br&gt;作成後は不変" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;strokeWidth=2;strokeColor=#16A34A;fillColor=#F0FDF4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320" y="1110" width="220" height="125" as="geometry"/></mxCell>
