                <mxCell id="section-domain" value="D: Domain Model" style="swimlane;html=1;startSize=38;rounded=0;strokeWidth=2;strokeColor=#000000;fillColor=#E6E6E6;fontSize=18;fontStyle=1;fontColor=#000000;connectable=0;" parent="1" vertex="1">
