                </mxCell>
                <mxCell id="d-rule" value="&lt;b&gt;Confirmed Rules&lt;/b&gt;&lt;br&gt;・GroupにはOwnerが必ず1人。招待・Group終了・全体CSVはOwnerだけ。譲渡前のOwnerは脱退不可。&lt;br&gt;・割合は10%単位・0%可・合計100%。最大剰余方式、同率は実支払者を優先する。&lt;br&gt;・支出登録時の参加者・割合は固定。途中参加は過去支出へ影響せず、脱退後も既存精算責務は残る。&lt;br&gt;・Snapshotは関係者全員承認後に支払指示を有効化。却下理由必須、Rejectedは不変で新版を関連付ける。&lt;br&gt;・Settlement Caseの対象Expense ID集合は初回申請で固定し、新版でも追加・除外しない。新規Expenseは別Caseとする。&lt;br&gt;・Awaiting Approval中は対象ExpenseをLock。Rejected時だけSource Owner／Group Ownerが同じIDを履歴付き訂正し、新版を再計算する。&lt;br&gt;・新版の再申請は元申請者またはGroup Ownerだけ。元申請者が対応不能でもOwnerが同じCaseを引き継ぐ。&lt;br&gt;・Group全体で最少送金回数に相殺し、同数候補は支払側・受取側のGroup参加順で決定する。&lt;br&gt;・支払指示ごとに受取確認する。差し戻し理由と再試行を残し、部分支払は不可。&lt;br&gt;・Category集計はoccurredOn、Settlement Archive表示はarchivedAtの月を使う（Asia/Tokyo）。&lt;br&gt;・全支払指示の受取確認後にSnapshotをArchiveし、編集不可・月別参照可能とする。&lt;br&gt;・Group終了1年後に全業務Dataを削除し、最小削除証跡もさらに1年後にBatch削除する。" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#000000;fillColor=#F2F2F2;fontColor=#000000;fontSize=9;" parent="section-domain" vertex="1">
                    <mxGeometry x="40" y="675" width="760" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="d-group" value="&lt;b&gt;Group&lt;/b&gt;&lt;hr&gt;Participant: 1..4 / Owner: 1&lt;br&gt;Active / Archived&lt;br&gt;archivedAt / deleteEligibleAt（1年後）" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="60" y="915" width="220" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="d-membership" value="&lt;b&gt;Membership / Invitation&lt;/b&gt;&lt;hr&gt;Role: Owner / Participant&lt;br&gt;参加順 / 参加・脱退時点&lt;br&gt;Active / Exited" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="330" y="930" width="230" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="d-expense" value="&lt;b&gt;Group Expense&lt;/b&gt;&lt;hr&gt;金額 / 実支払者 / occurredOn&lt;br&gt;Source Owner: 登録者 / Receipt Uploader&lt;br&gt;Rejected時: Source Owner／Group Ownerが訂正" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="610" y="930" width="230" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="d-allocation" value="&lt;b&gt;Split Allocation&lt;/b&gt;&lt;hr&gt;割合: 0〜100%・10%単位 / 合計100%&lt;br&gt;最大剰余方式&lt;br&gt;同率時: 実支払者 → Group参加順" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="610" y="1090" width="230" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="d-balance" value="&lt;b&gt;Participant Balance&lt;/b&gt;&lt;hr&gt;実支払額合計 − 負担額合計&lt;br&gt;Group合計 = 0円" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;" parent="1" vertex="1">
                    <mxGeometry x="330" y="1110" width="230" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="d-plan" value="&lt;b&gt;Settlement Case / Snapshot Revision&lt;/b&gt;&lt;hr&gt;Case ID / fixed Expense IDs / requester&lt;br&gt;Revision / previousSnapshotId&lt;br&gt;再申請: 元申請者 / Group Owner&lt;br&gt;Awaiting Approval → Rejected / Payment Active → Archived" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;" parent="1" vertex="1">
